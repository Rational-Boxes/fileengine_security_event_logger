# audit_service configuration.
#
# It reaches the SAME Redis broker and the SAME Postgres the core uses — the
# tenant schemas and their audit_log tables live in the core database. In
# production these values come from the shared deployment env, not this file.

# --- Redis: the aggregating security-event sink ---
FILEENGINE_REDIS_HOST=localhost
FILEENGINE_REDIS_PORT=6379
FILEENGINE_REDIS_PASSWORD=
FILEENGINE_REDIS_DB=0
# The audit stream is separate from the fail-open fileengine:events stream.
FILEENGINE_AUDIT_STREAM=fileengine:audit
AUDIT_CONSUMER_GROUP=audit-writer
AUDIT_CONSUMER_NAME=writer-1
AUDIT_READ_COUNT=256
AUDIT_READ_BLOCK_MS=5000

# --- Postgres: the CORE database (tenant schemas + audit_log) ---
FILEENGINE_PG_HOST=localhost
FILEENGINE_PG_PORT=5432
FILEENGINE_PG_DATABASE=fileengine
FILEENGINE_PG_USER=postgres
FILEENGINE_PG_PASSWORD=postgres
AUDIT_DB_STATEMENT_TIMEOUT_MS=10000

# --- Telling a deployment administrator (PROPOSAL_deployment_admin_signal §5) --
# Unset, audit-rules logs every mandatory incident as UNDELIVERED rather than
# pretending. Comma-separated: one address is a single point of leave.
AUDIT_ADMIN_EMAILS=
AUDIT_SMTP_HOST=
AUDIT_SMTP_PORT=25
AUDIT_SMTP_FROM=
AUDIT_SMTP_TLS=false

# --- Retention (design_documents/SPEC_retention_and_archival.md) ---
# Two complete calendar months stay in Postgres; `audit-retention` (monthly)
# archives the rest into the MAIN store under <tenant>/_audit/ and drops it.
FILEENGINE_AUDIT_RETENTION_MONTHS=2
# Fernet key(s), comma-separated; the first encrypts. Required to archive.
# Deployments derive it from AT_REST_KEY: `audit-archive derive-key < at-rest-key`.
FILEENGINE_AUDIT_ARCHIVE_KEY=
# Also retain the core's accountability record, under <tenant>/_accountability/.
AUDIT_ACCOUNTABILITY_RETENTION=true
# s3 = the main store; every S3 setting defaults to the core's FILEENGINE_S3_*.
AUDIT_ARCHIVE_BACKEND=s3
FILEENGINE_S3_ENDPOINT=http://localhost:9000
FILEENGINE_S3_BUCKET=fileengine
FILEENGINE_S3_ACCESS_KEY=
FILEENGINE_S3_SECRET_KEY=
FILEENGINE_S3_PATH_STYLE=true
# Lifecycle simulation clock: --today / AUDIT_RETENTION_TODAY, honoured ONLY with
# AUDIT_ALLOW_DATE_OVERRIDE=true. Never set this in production.
AUDIT_ALLOW_DATE_OVERRIDE=false
