# audit_service configuration.
#
# It reaches the SAME Redis broker and the SAME Postgres the core uses — the
# tenant schemas and their audit_log tables live in the core database. In
# production these values come from the shared deployment env, not this file.

# --- Redis: the aggregating security-event sink ---
FILEENGINE_REDIS_HOST=localhost
FILEENGINE_REDIS_PORT=6379
FILEENGINE_REDIS_PASSWORD=
FILEENGINE_REDIS_DB=0
# The audit stream is separate from the fail-open fileengine:events stream.
FILEENGINE_AUDIT_STREAM=fileengine:audit
AUDIT_CONSUMER_GROUP=audit-writer
AUDIT_CONSUMER_NAME=writer-1
AUDIT_READ_COUNT=256
AUDIT_READ_BLOCK_MS=5000

# --- Postgres: the CORE database (tenant schemas + audit_log) ---
FILEENGINE_PG_HOST=localhost
FILEENGINE_PG_PORT=5432
FILEENGINE_PG_DATABASE=fileengine
FILEENGINE_PG_USER=postgres
FILEENGINE_PG_PASSWORD=postgres
AUDIT_DB_STATEMENT_TIMEOUT_MS=10000
